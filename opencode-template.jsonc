{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "esek",
  "providers": {
    "esek": {
      "name": "E-sektionen",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.esek.se/v1",
        "apiKey": "<token goes here>"
      },
      "models": {
        "mistral-small": {
          "modelID": "mistral-small",
          "name": "esek: Mistral Small 4",
          "limit": {"context": 256000, "output": 16384},
          "settings": {"reasoningEffort": "high"}
        },
        "eu-cheap": {
          "modelID": "eu-cheap",
          "name": "esek: Default cheap model (currently Mistral Small 4)",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "low"}
        },
        "mistral-large": {
          "modelID": "mistral-large",
          "name": "esek: Mistral Large 4",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "low"}
        },
        "deepseek-v4.1-flash": {
          "modelID": "deepseek-v4.1-flash",
          "name": "esek: DeepSeek V4.1 Flash (non-EU!)",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "high"}
        },
        "external-cheap": {
          "modelID": "external-cheap",
          "name": "esek: Default cheap non-EU model (currently DeepSeek 4.1 Flash by OpenInference) (non-EU!)",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "low"}
        },
        "gpt-6.1-sol": {
          "modelID": "gpt-6.1-luna",
          "name": "esek: GPT 6.1 Luna",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "high"}
        },
        "eu-medium": {
          "modelID": "eu-medium",
          "name": "esek: Default middle model (currently GPT 6.1 sol)",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "low"}
        },
        "claude-opus-5.5": {
          "modelID": "claude-opus-5.5",
          "name": "esek: Claude Opus 5.5",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "low"}
        },
        "eu-expensive": {
          "modelID": "eu-expensive",
          "name": "esek: Default expensive model (currently Opus 5.5)",
          "limit": {"context": 1000000, "output": 16384},
          "settings": {"reasoningEffort": "low"}
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {"action": "provider.use", "resource": "*", "effect": "deny"},
      {"action": "provider.use", "resource": "esek", "effect": "allow"}
    ]
  }
}
